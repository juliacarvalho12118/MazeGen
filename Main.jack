/** Inicializa o jogo Ghost Multiplayer e o executa ate o ESC ser pressionado. */
class Main {
    function void main() {
        var GhostGame game;
        let game = GhostGame.new();
        do game.run();
        do game.dispose();
        return;
    }
}
