// Parte do projeto Ghost Multiplayer (Projeto 6).
// Adaptado de Square.jack (nand2tetris, projects/09) e do Ghost original.

/**
 * Representa o FANTASMA (Jogador 1).
 *
 * A posicao e guardada em CELULAS da grade do mapa (cada celula = 16x16 pixels):
 *   col: 0..31   (512 pixels / 16)
 *   row: 0..15   (256 pixels / 16)  -> a linha 0 e reservada para o relogio (HUD)
 *
 * Direcao: 0 = parado, 1 = cima, 2 = baixo, 3 = esquerda, 4 = direita.
 *
 * Esta classe NAO conhece o mapa: ela apenas diz qual seria a proxima celula
 * (nextCol/nextRow) e se move quando o GhostGame manda (moveTo). Quem decide
 * se a celula e livre (parede/limite) e o GhostGame.
 */
class Ghost {

   field int col, row;     // posicao atual, em celulas
   field int direction;    // direcao atual de deslocamento

   /** Cria o fantasma na celula (Acol, Arow). Nao desenha: use reset(). */
   constructor Ghost new(int Acol, int Arow) {
      let col = Acol;
      let row = Arow;
      let direction = 0;
      return this;
   }

   /** Libera a memoria do fantasma. */
   method void dispose() {
      do Memory.deAlloc(this);
      return;
   }

   // ---------------- Consultas ----------------

   method int getCol() { return col; }
   method int getRow() { return row; }
   method int getDirection() { return direction; }

   /** Coluna da celula seguinte se o fantasma continuar na direcao atual. */
   method int nextCol() {
      if (direction = 3) { return col - 1; }   // esquerda
      if (direction = 4) { return col + 1; }   // direita
      return col;
   }

   /** Linha da celula seguinte se o fantasma continuar na direcao atual. */
   method int nextRow() {
      if (direction = 1) { return row - 1; }   // cima
      if (direction = 2) { return row + 1; }   // baixo
      return row;
   }

   // ---------------- Controle ----------------

   /** Define a direcao; o fantasma passa a andar sozinho nessa direcao. */
   method void setDirection(int d) {
      let direction = d;
      return;
   }

   /** Para o fantasma (tecla de parar ou batida em obstaculo). */
   method void stop() {
      let direction = 0;
      return;
   }

   /**
    * Coloca o fantasma em (Acol, Arow) SEM apagar a posicao antiga e o desenha.
    * Usado no inicio de cada rodada, depois que o mapa ja foi desenhado
    * (apagar a posicao antiga poderia apagar um pedaco de parede).
    */
   method void reset(int Acol, int Arow) {
      let col = Acol;
      let row = Arow;
      let direction = 0;
      do draw();
      return;
   }

   /** Move o fantasma para a celula (Acol, Arow), apagando a antiga. */
   method void moveTo(int Acol, int Arow) {
      do erase();
      let col = Acol;
      let row = Arow;
      do draw();
      return;
   }

   // ---------------- Desenho ----------------

   /** Desenha o fantasma na tela. */
   method void draw() {
      // endereco da memoria de video: 16384 + (linha de pixels * 32) + palavra
      // linha de pixels = row * 16  ->  row * 16 * 32 = row * 512
      do drawHappyGhost((row * 512) + col);
      return;
   }

   /** Apaga o fantasma (pinta de branco a celula de 16x16 pixels). */
   method void erase() {
      var int x, y;
      let x = col * 16;
      let y = row * 16;
      do Screen.setColor(false);
      do Screen.drawRectangle(x, y, x + 15, y + 15);
      return;
   }

   /** Sprite 16x16 do fantasma (reaproveitado do Ghost original). */
   method void drawHappyGhost(int location) {
      var int memAddress;
      let memAddress = 16384 + location;
      do Memory.poke(memAddress+0, 8184);
      do Memory.poke(memAddress+32, 16380);
      do Memory.poke(memAddress+64, 25542);
      do Memory.poke(memAddress+96, -1);
      do Memory.poke(memAddress+128, -2065);
      do Memory.poke(memAddress+160, -7225);
      do Memory.poke(memAddress+192, -7225);
      do Memory.poke(memAddress+224, -2065);
      do Memory.poke(memAddress+256, -1);
      do Memory.poke(memAddress+288, -1);
      do Memory.poke(memAddress+320, -1);
      do Memory.poke(memAddress+352, -4081);
      do Memory.poke(memAddress+384, -2017);
      do Memory.poke(memAddress+416, -961);
      do Memory.poke(memAddress+448, -1);
      do Memory.poke(memAddress+480, -1);
      return;
   }
}
