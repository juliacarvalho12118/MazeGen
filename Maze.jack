// ATENCAO: Maze SO PARA TESTE (stub). NAO e o Maze do projeto.
// Serve apenas para compilar/testar Ghost, Person e GhostGame enquanto o
// Maze de verdade nao fica pronto. Mesma interface que o GhostGame espera.
class Maze {

   constructor Maze new() {
      return this;
   }

   method void dispose() {
      do Memory.deAlloc(this);
      return;
   }

   /** true se a celula (col 0..31, row 1..15) e parede. */
   method boolean isWall(int col, int row) {
      if ((col = 0) | (col = 31)) { return true; }
      if ((row = 1) | (row = 15)) { return true; }
      if ((col = 8) & ((row > 3) & (row < 15))) { return true; }
      if ((col = 16) & ((row > 1) & (row < 12))) { return true; }
      if ((row = 8) & ((col > 16) & (col < 26))) { return true; }
      return false;
   }

   /** Desenha as paredes (linhas 1..15). */
   method void draw() {
      var int c, r;
      do Screen.setColor(true);
      let r = 1;
      while (r < 16) {
         let c = 0;
         while (c < 32) {
            if (isWall(c, r)) {
               do Screen.drawRectangle(c * 16, r * 16, (c * 16) + 15, (r * 16) + 15);
            }
            let c = c + 1;
         }
         let r = r + 1;
      }
      return;
   }
}
